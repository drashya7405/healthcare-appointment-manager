# Database (Neon PostgreSQL in Production, local PostgreSQL in Development)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# Session Security (32+ characters random string)
AUTH_SECRET="generate-a-secure-random-32-char-secret-for-production"

# Application Base URL (Used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# AI Integration — Groq Free API
AI_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
AI_MOCK_FAILURE="false"

# Email Notifications — Resend / Mock
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Healthcare Clinic <onboarding@resend.dev>"
EMAIL_MOCK_FAILURE="false"

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-project.vercel.app/api/auth/google/callback"
GOOGLE_MOCK_CALENDAR="false"
GOOGLE_MOCK_CALENDAR_FAILURE="false"

# Background Jobs — Inngest (Optional if running standalone)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
